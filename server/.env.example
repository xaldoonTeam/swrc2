# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/swrc?schema=public"

# JWT secret (generate a long random string for production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server
PORT=3001

# Optional: base URL for file links (e.g. https://api.yoursite.com)
API_BASE_URL="http://localhost:3001"

# Upload directory (relative to server root)
UPLOAD_DIR="uploads"
